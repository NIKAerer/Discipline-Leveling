# Valeurs utilisées uniquement par les tests automatisés (aucune donnée réelle).
KERNEL_CLASS='App\Kernel'
APP_SECRET='test_only_not_a_secret'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
JWT_PASSPHRASE=test_only_not_a_secret
# Clés JWT dédiées aux tests, pour ne pas toucher à celles du développement
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private-test.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public-test.pem
